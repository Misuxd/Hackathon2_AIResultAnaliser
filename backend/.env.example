# Demo mode requires no credentials.
GEO_OPENAI_KEY=
GEO_PERPLEXITY_KEY=
GEO_OPENAI_MODEL=gpt-4.1-mini
GEO_PERPLEXITY_MODEL=fast
# Optional server restriction for HTTPS fetching, e.g. example.com,www.example.com.
# When blank, the optimizer can fetch the public URL entered in the form.
# Additional redirect hosts are configured per fetch and must pass any server restriction.
GEO_FETCH_HOSTS=
GEO_DB_PATH=.data/audits.sqlite3
GEO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
