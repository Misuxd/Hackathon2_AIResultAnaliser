# Demo mode requires no credentials. Live mode is selected explicitly in the UI.
GEO_OPENAI_KEY=
GEO_PERPLEXITY_KEY=
GEO_GEMINI_KEY=
GEO_OPENAI_MODEL=gpt-4.1-mini
GEO_PERPLEXITY_MODEL=sonar-pro
GEO_GEMINI_MODEL=gemini-2.5-flash
# Exact public hostnames the optimizer may fetch over HTTPS, separated by commas.
# Use hostnames only, e.g. example.com,www.example.com. List redirect hosts too.
# Leave empty to disable page fetching and use pasted content instead.
GEO_FETCH_HOSTS=
GEO_DB_PATH=.data/audits.sqlite3
GEO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
