# Demo mode requires no credentials. Live mode is selected explicitly in the UI.
GEO_OPENAI_KEY=
GEO_PERPLEXITY_KEY=
GEO_GEMINI_KEY=
GEO_OPENAI_MODEL=gpt-4.1-mini
GEO_PERPLEXITY_MODEL=sonar-pro
GEO_GEMINI_MODEL=gemini-2.5-flash
# Comma-separated exact public hostnames allowed for optional page fetching.
# Empty disables remote fetching; paste page content in the optimizer instead.
GEO_FETCH_HOSTS=
GEO_DB_PATH=.data/audits.sqlite3
GEO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
